      "source": [
        "## 7. Monte Carlo simulation\n",
        "Each trial selects a historical hour uniformly at random, with replacement. Count trials above the threshold and divide by the number of trials. This is empirical Monte Carlo, not a fitted forecast model. The same random.random(), loop, condition and counter pattern as the Pi lab is used. The fixed seed makes the run reproducible."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 29,
      "id": "6d985b00",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6d985b00",
        "outputId": "02d20790-ece1-4abd-c865-353ece503a57"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Number of trials: 10000\n",
            "P(Demand > 500): 0.074\n",
            "P(Demand > 800): 0.0096\n",
            "Percentage above 500: 7.4\n",
            "Percentage above 800: 0.96\n"
          ]
        }
      ],
      "source": [
        "random.seed(42)\n",
        "num_points = 10000\n",
        "\n",
        "def simulate_demand(values, num_points):\n",
        "    above_500 = 0\n",
        "    above_800 = 0\n",
        "    simulated = []\n",
        "    for _ in range(num_points):\n",
        "        # random.random() produces a number in [0, 1)\n",
        "        index = int(random.random() * len(values))\n",
        "        value = values[index]\n",
        "        simulated.append(value)\n",
        "        if value > 500:\n",
        "            above_500 += 1\n",
        "        if value > 800:\n",
        "            above_800 += 1\n",
        "    return above_500 / num_points, above_800 / num_points, simulated\n",
        "\n",
        "p500, p800, simulated = simulate_demand(demand, num_points)\n",
        "print('Number of trials:', num_points)\n",
        "print('P(Demand > 500):', p500)\n",
        "print('P(Demand > 800):', p800)\n",
        "print('Percentage above 500:', round(p500 * 100, 2))\n",
        "print('Percentage above 800:', round(p800 * 100, 2))"
      ]
    },
