      "source": [
        "## 3. Two-sample t-test\n",
        "Compare daily rental totals, rather than treating every hour of the same day as independent. H0: equal mean daily rentals on working and non-working days. H1: different means. Alpha = 0.05. The lab uses a pooled t-test; here we retain that method and show sample standard deviations so its equal-variance assumption is visible."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 25,
      "id": "f30ed9c6",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "f30ed9c6",
        "outputId": "67c9abcd-851f-4760-c553-87c57df356b0"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Working day mean: 4584.82\n",
            "Non-working day mean: 4330.168831168831\n",
            "Working day SD: 1878.4155828260175\n",
            "Non-working day SD: 2052.1412448375504\n",
            "t-statistic: 1.6543102137118633\n",
            "p-value: 0.09849496160024913\n",
            "Fail to reject H0: insufficient evidence of a difference.\n"
          ]
        }
      ],
      "source": [
        "daily = data.groupby(['dteday', 'workingday'])['cnt'].sum().reset_index()\n",
        "data1 = np.array(daily[daily['workingday'] == 1]['cnt'])\n",
        "data2 = np.array(daily[daily['workingday'] == 0]['cnt'])\n",
        "\n",
        "t_statistic, p_value = stats.ttest_ind(data1, data2, equal_var=True)\n",
        "alpha = 0.05\n",
        "print('Working day mean:', np.mean(data1))\n",
        "print('Non-working day mean:', np.mean(data2))\n",
        "print('Working day SD:', np.std(data1, ddof=1))\n",
        "print('Non-working day SD:', np.std(data2, ddof=1))\n",
        "print('t-statistic:', t_statistic)\n",
        "print('p-value:', p_value)\n",
        "\n",
        "if p_value < alpha:\n",
        "    print('Reject H0: significant difference in mean daily rentals.')\n",
        "else:\n",
        "    print('Fail to reject H0: insufficient evidence of a difference.')"
      ]
    },
