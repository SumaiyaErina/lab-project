      "source": [
        "# Compare weather and day type using the same simulation function\n",
        "scenarios = [\n",
        "    ('Clear/fair', data[data['weather'] == 1]),\n",
        "    ('Mist/cloudy', data[data['weather'] == 2]),\n",
        "    ('Adverse', data[data['weather'] == 3]),\n",
        "    ('Working day', data[data['workingday'] == 1]),\n",
        "    ('Non-working day', data[data['workingday'] == 0])\n",
        "]\n",
        "names, rates500, rates800 = [], [], []\n",
        "for name, group in scenarios:\n",
        "    a, b, _ = simulate_demand(np.array(group['cnt']), num_points)\n",
        "    names.append(name)\n",
        "    rates500.append(a * 100)\n",
        "    rates800.append(b * 100)\n",
        "    print(name, ': >500 =', round(a*100, 2), '%, >800 =', round(b*100, 2), '%')\n",
        "\n",
        "x = np.arange(len(names))\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.bar(x, rates500, width=0.4, label='>500')\n",
        "plt.bar(x + 0.4, rates800, width=0.4, label='>800')\n",
        "plt.xticks(x + 0.2, names, rotation=15)\n",
        "plt.ylabel('Simulated probability (%)')\n",
        "plt.title('Monte Carlo Demand Probability by Scenario')\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
